# Grafana Cloud log shipping — read by the `alloy` service in docker-compose.yml.
# On EC2 copy this to ~/garagepulse/.env.alloy. Find the values in Grafana Cloud:
# My Account -> your stack -> Loki -> Details (URL and user), and an access
# policy token with the logs:write scope.
GRAFANA_LOKI_URL=https://logs-prod-028.grafana.net
GRAFANA_LOKI_USER=18360
GRAFANA_LOKI_TOKEN=glc_....
