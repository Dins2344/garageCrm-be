# ─── GaragePulse Backend — Production Environment ───
# Copy this file to .env.production and fill in your values

PORT=5000
NODE_ENV=production

# PostgreSQL — Neon's *pooled* connection string for the app (the one with
# "-pooler" in the host). Schema migrations in drizzle/ apply at boot.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/garagepulse?sslmode=require

# JWT — CHANGE THIS to a strong random secret
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRE=10m

# CORS — Your frontend domain (after frontend deployment)
CLIENT_URL=https://your-frontend-domain.com

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="GaragePulse" <noreply@garagepulse.com>

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Expo push (optional) — access token for the Expo push service. Without it
# pushes are still sent, just unauthenticated.
EXPO_ACCESS_TOKEN=

# Platform admin — signing key for admin console tokens.
# Must be different from JWT_SECRET. There is no fallback: admin login fails
# without it. Admin accounts themselves live in the database, not here —
# create one with: npx tsx scripts/manageAdmin.ts create <email> "<Name>"
SUPER_ADMIN_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_SECRET

# MyGarage cloud sync (optional). If any of these is missing or invalid, MyGarage
# turns itself off and GaragePulse is unaffected.
# Postgres connection string for the separate MyGarage database.
MYGARAGE_DATABASE_URL=postgresql://neondb_3.ap-southeast-1.aws.neon.tech/mygarage?sslmode=require&channel_binding=require
# Signs MyGarage tokens. At least 32 characters; must differ from JWT_SECRET and SUPER_ADMIN_SECRET.
MYGARAGE_JWT_SECRET=mygarageJWTscret
# 32 random bytes, base64. Keep a copy outside this server: losing it makes all MyGarage cloud data unreadable.
MYGARAGE_MASTER_KEY=
# Google OAuth web client id the MyGarage app signs in with.
MYGARAGE_GOOGLE_WEB_CLIENT_ID=125851234930-rq419n1kd725320eusercontent.com
# Cloudflare R2 account id for MyGarage file storage.
R2_ACCOUNT_ID=c24f2a3ee8445f9e
# R2 access key id.
R2_ACCESS_KEY_ID=ae3f5d00f63
# R2 secret access key.
R2_SECRET_ACCESS_KEY=0b7c593bff825aadbbb39e7e9992b3423ab1e
# R2 bucket name.
R2_BUCKET=mygarage
