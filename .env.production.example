# ─── GaragePulse Backend — Production Environment ───
# Copy this file to .env.production and fill in your values

PORT=5000
NODE_ENV=production

# PostgreSQL — Neon's *pooled* connection string for the app (the one with
# "-pooler" in the host). Schema migrations in drizzle/ apply at boot.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/garagepulse?sslmode=require

# JWT — CHANGE THIS to a strong random secret
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRE=30d

# CORS — Your frontend domain (after frontend deployment)
CLIENT_URL=https://your-frontend-domain.com

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="GaragePulse" <noreply@garagepulse.com>

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Platform admin — signing key for admin console tokens.
# Must be different from JWT_SECRET. There is no fallback: admin login fails
# without it. Admin accounts themselves live in the database, not here —
# create one with: npx tsx scripts/manageAdmin.ts create <email> "<Name>"
SUPER_ADMIN_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHAR_SECRET
