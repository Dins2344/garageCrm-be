# ─── GaragePulse Backend — Production Environment ───
# Copy this file to .env.production and fill in your values

PORT=5000
NODE_ENV=production

# MongoDB — Use MongoDB Atlas or your own MongoDB instance
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/garagepulse?retryWrites=true&w=majority

# JWT — CHANGE THIS to a strong random secret
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRE=30d

# CORS — Your frontend domain (after frontend deployment)
CLIENT_URL=https://your-frontend-domain.com

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="GaragePulse" <noreply@garagepulse.com>

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
