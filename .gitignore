node_modules/
# Every env variant, including timestamped backups. The bare .env +
# .env.production pair used to be the whole rule, which left an ad-hoc
# .env.bak-* untracked-but-committable with real secrets in it.
.env
.env.*
# ...except the checked-in template.
!.env.*.example
logs/*.log
uploads/
*.tar.gz
nginx/ssl/
dist/
coverage/

# Claude Code personal settings — machine-specific, never shared.
# Committed project settings live in .claude/settings.json.
.claude/settings.local.json
